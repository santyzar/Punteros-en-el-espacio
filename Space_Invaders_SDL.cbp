			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="enemigos.h" />
		<Unit filename="escudos.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="escudos.h" />
		<Unit filename="juego.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="juego.h" />
		<Unit filename="jugador.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="jugador.h" />
		<Unit filename="main.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="pantalla.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="pantalla.h" />
		<Extensions />
	</Project>
